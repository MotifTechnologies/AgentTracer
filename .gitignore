# Internal documents — never commit (government project docs, internal specs)
confidential/

# Secrets. The sample is the one .env-shaped file that must stay tracked:
# it is what `cp .env.sample .env` in the README copies.
.env
.env.*
!.env.sample

# Python / uv
__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Run outputs
results/
*.traj.json

# Seed corpora are generated (via DATA_BUILDER/, the user's job — not this
# framework's); only small tracked samples ship with the repo. `data/*` with
# re-included `data/seeds` rather than a bare `data/`: git does not descend
# into an ignored directory, so a negation under one never fires — the old
# blanket rule silently killed the sample exception.
data/*
!data/seeds
data/seeds/*
!data/seeds/*sample*.jsonl
DATA_BUILDER/

# Generated report deck
*.pptx
