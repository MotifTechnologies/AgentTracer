# Copy to .env and fill in. Loaded at startup (python-dotenv); every `env:VAR`
# reference in a config resolves here or in the environment, and an
# unresolvable one refuses the run before any task starts (fail-fast).

# Key sent to the OpenAI-compatible serving endpoint (`model.api_key:
# env:VLLM_API_KEY` in the shipped configs). vLLM started with --api-key
# checks it; for a server started without one, any non-empty value works.
VLLM_API_KEY=

# Only for `tools.web: true`. web_search calls Brave Search; without a key the
# run refuses to start rather than silently dropping the tool.
# BRAVE_API_KEY=
